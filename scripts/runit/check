#!/data/data/com.termux/files/usr/bin/sh
# PhonixOS — verificação de disponibilidade (contracts.md §5.1, GET /api/v1/health).
# Usado pelo runit em `sv start|restart|check` e pelo serviço auxiliar health/run.
# Saída 0 somente para HTTP 200; 1 para qualquer outra resposta, timeout ou recusa.
# O exit code deste script, sozinho, não reinicia o serviço.

PREFIX="${PREFIX:-/data/data/com.termux/files/usr}"
PATH="$PREFIX/bin:$PATH"
export PATH

PHONIX_HEALTH_URL="${PHONIX_HEALTH_URL:-http://127.0.0.1:8080/api/v1/health}"

code=$(curl --silent --noproxy '*' --connect-timeout 3 --max-time 3 \
	--output /dev/null --write-out '%{http_code}' "$PHONIX_HEALTH_URL" 2>/dev/null)

[ "$code" = "200" ] && exit 0
exit 1
